{
  "id": "./index.html",
  "name": "TAJER — Caisse, stock & clients",
  "short_name": "TAJER",
  "description": "Ta caisse, ton stock, tes clients — hors-ligne.",
  "lang": "fr",
  "dir": "ltr",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#FAF7F1",
  "theme_color": "#131A24",
  "categories": ["business", "finance", "productivity"],
  "prefer_related_applications": false,
  "launch_handler": { "client_mode": ["focus-existing", "auto"] },
  "icons": [
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "maskable" },
    { "src": "icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Nouvelle vente", "short_name": "Vente", "url": "./index.html#nouvelle-vente", "icons": [{ "src": "shortcut-96.png", "sizes": "96x96", "type": "image/png" }] },
    { "name": "Clients", "url": "./index.html#clients", "icons": [{ "src": "shortcut-96.png", "sizes": "96x96", "type": "image/png" }] },
    { "name": "Achats", "url": "./index.html#achats", "icons": [{ "src": "shortcut-96.png", "sizes": "96x96", "type": "image/png" }] },
    { "name": "Bilan", "url": "./index.html#bilan", "icons": [{ "src": "shortcut-96.png", "sizes": "96x96", "type": "image/png" }] }
  ],
  "protocol_handlers": [
    { "protocol": "web+tajer", "url": "./index.html#proto=%s" }
  ],
  "file_handlers": [
    { "action": "./index.html", "accept": { "application/json": [".json"] }, "launch_type": "single-client" }
  ]
}
